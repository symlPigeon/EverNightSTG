[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
windows.debug.x86_64   = "res://../target/release/evernight_godot.dll"
windows.release.x86_64 = "res://../target/release/evernight_godot.dll"
linux.debug.x86_64     = "res://../target/debug/libevernight_godot.so"
linux.release.x86_64   = "res://../target/release/libevernight_godot.so"
macos.debug            = "res://../target/debug/libevernight_godot.dylib"
macos.release          = "res://../target/release/libevernight_godot.dylib"
